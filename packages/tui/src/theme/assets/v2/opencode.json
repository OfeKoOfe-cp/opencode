      },
      "accent": "$hue.orange",
      "interactive": "$hue.brown",
      "neutral": "$hue.gray",
      "brown": {
        "100": "#5e3a26",
        "200": "#7a4d31",
        "300": "#96603c",
        "400": "#b3764b",
        "500": "#cd9063",
        "600": "#dfae87",
        "700": "#ecccb0",
        "800": "#f5e4d0",
        "900": "#fbf3e9"
      }
    },
    "categorical": [
      "brown",
      "orange",
      "green",
      "purple",
      "red"
    ],
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      },
      "feedback": {
        "warning": {
          "base": "$hue.accent.200"
        }
      }
    },
    "border": {
      "base": "#b8b8b8"
    },
    "scrollbar": {
      "base": "#a0a0a0"
    },
    "diff": {
      "text": {
        "added": "#2f7a5c",
        "context": "#9a8f9e",
        "hunkHeader": "#9a8f9e"
      },
      "background": {
        "added": "#dde8da",
        "removed": "#f2ded7"
      },
      "highlight": {
        "added": "#5aa77d",
        "removed": "#d9585f"
      },
      "lineNumber": {
        "text": "#5b4c3d",
        "background": {
          "added": "#cddcc8",
          "removed": "#e5cfc7"
        }
      }
    },
    "syntax": {
      "number": "$hue.accent.200",
      "type": "#8f6a2c"
    },
    "markdown": {
      "blockQuote": "#8f6a2c",
      "emphasis": "#8f6a2c",
      "strong": "$hue.accent.200"
    }
  },
