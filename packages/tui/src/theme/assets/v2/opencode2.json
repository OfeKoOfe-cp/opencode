{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "brown",
      "purple",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "#c98f52"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#4a3c2e"
    },
    "scrollbar": {
      "base": "#63523f"
    },
    "diff": {
      "text": {
        "added": "#6fc7a8",
        "removed": "#c26a5a",
        "context": "#9a8f9e",
        "hunkHeader": "#9a8f9e"
      },
      "background": {
        "added": "#24211c",
        "removed": "#2e211d",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#c2cf9a",
        "removed": "#d4857c"
      },
      "lineNumber": {
        "text": "#8a7a67",
        "background": {
          "added": "#1f1c17",
          "removed": "#2a1e1a"
        }
      }
    },
    "syntax": {
      "comment": "#808080",
      "keyword": "#9d7cd8",
      "function": "#fab283",
      "variable": "#e06c75",
      "string": "#7fd88f",
      "number": "#c98f52",
      "type": "#cfa96f",
      "operator": "#56b6c2",
      "punctuation": "#eeeeee"
    },
    "markdown": {
      "text": "#eeeeee",
      "heading": "#9d7cd8",
      "link": "#fab283",
      "linkText": "#56b6c2",
      "code": "#7fd88f",
      "blockQuote": "#cfa96f",
      "emphasis": "#cfa96f",
      "strong": "#c98f52",
      "horizontalRule": "#808080",
      "listItem": "#fab283",
      "listEnumeration": "#56b6c2",
      "image": "#fab283",
      "imageText": "#56b6c2",
      "codeBlock": "#eeeeee"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#241c14",
