    },
    "syntax": {
      "comment": "#8a8a8a",
      "keyword": "#d68c27",
      "function": "#3b7dd8",
      "variable": "#d1383d",
      "string": "#3d9a57",
      "number": "#d68c27",
      "type": "#8f6a2c",
      "operator": "#318795",
      "punctuation": "#1a1a1a"
    },
    "markdown": {
      "text": "#1a1a1a",
      "heading": "#d68c27",
      "link": "#3b7dd8",
      "linkText": "#318795",
      "code": "#3d9a57",
      "blockQuote": "#8f6a2c",
      "emphasis": "#8f6a2c",
      "strong": "#d68c27",
      "horizontalRule": "#8a8a8a",
      "listItem": "#3b7dd8",
      "listEnumeration": "#318795",
      "image": "#3b7dd8",
      "imageText": "#318795",
      "codeBlock": "#1a1a1a"
    },
    "@dialog": {
      "background": {
        "base": "$hue.neutral.800",
        "raised": {
          "high": "$hue.neutral.700"
        },
        "action": {
          "primary": {
            "$hovered": "$hue.neutral.600"
          },
          "secondary": {
            "$hovered": "$hue.neutral.600"
          }
        }
      }
    },
    "categorical": [
      "brown",
      "orange",
      "green",
      "purple",
      "red"
    ]
  },
